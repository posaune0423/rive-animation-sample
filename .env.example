# Show the debug HUD (fps, lanes, metrics). Default: true
NEXT_PUBLIC_DEBUG_HUD=true

# Queue policy for T2+ effects. per-lane: chatTop/center/full run concurrently (one each).
# strict: every T2+ effect is serialized into a single queue. Default: per-lane
NEXT_PUBLIC_QUEUE_POLICY=per-lane

# Max number of waiting T2 effects before the oldest is dropped. Default: 5
NEXT_PUBLIC_T2_QUEUE_MAX=5
